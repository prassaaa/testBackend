# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment mode: development | production | test
NODE_ENV=development

# Application port (default: 3000)
PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# For Docker: Use service name from docker-compose.yml as HOST
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/testbackend_db?schema=public"

# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis host (use 'redis' for Docker service name)
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=redis123

# ============================================
# CACHE CONFIGURATION
# ============================================

# Cache TTL in seconds (default: 900 = 15 minutes)
# This controls how long weather data is cached in Redis
CACHE_TTL=900

# ============================================
# WEATHER MODULE CONFIGURATION
# ============================================

# Cron schedule for weather data collection
# Format: "minute hour day month dayOfWeek"
# Default: "*/15 * * * *" (every 15 minutes)
# Examples:
#   - "*/10 * * * *" = every 10 minutes
#   - "0 * * * *"    = every hour
#   - "0 0 * * *"    = every day at midnight
WEATHER_CRON_SCHEDULE="*/15 * * * *"

# Target city for automatic weather data collection
WEATHER_TARGET_CITY=Jakarta

# Timezone for scheduler (IANA timezone format)
# Examples: Asia/Jakarta, America/New_York, Europe/London
WEATHER_TIMEZONE=Asia/Jakarta

# Data retention period in days (older data will be cleaned up)
WEATHER_DATA_RETENTION_DAYS=30

# Weather API endpoints (Open-Meteo - no API key required)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1

# ============================================
# PAGINATION CONFIGURATION
# ============================================

# Default page size for paginated endpoints
DEFAULT_PAGE_SIZE=10

# Maximum page size allowed
MAX_PAGE_SIZE=100

# ============================================
# NOTES
# ============================================

# 1. Copy this file to .env and fill in your values:
#    cp .env.example .env
#
# 2. Never commit .env file to version control
#
# 3. For production deployment:
#    - Change NODE_ENV to 'production'
#    - Use strong passwords for DATABASE_URL and REDIS_PASSWORD
#    - Consider using environment-specific secrets management
#
# 4. For Docker deployment:
#    - Change REDIS_HOST to 'redis' (service name in docker-compose.yml)
#    - Change DATABASE_URL host to 'postgres' (service name)
#
# 5. Ensure PostgreSQL and Redis are running before starting the app:
#    docker-compose up -d
#
# 6. Run database migrations after setting up .env:
#    npx prisma migrate dev
#    npx prisma generate
